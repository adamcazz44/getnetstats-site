# Production build-time config. Safe to commit — NEXT_PUBLIC_* values are public
# (they end up in the client bundle / page source anyway).

# Google AdSense publisher id. Activates: the adsbygoogle.js loader in <head>,
# the google-adsense-account verification meta tag, and /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-2462592874316838

# 300x600 half-page ad-unit slot id. Set this AFTER AdSense approves the site and
# you create the display ad unit, then rebuild — that's when ads actually serve.
# NEXT_PUBLIC_ADSENSE_HALFPAGE_SLOT=

# Google Analytics 4 measurement id. Public (ends up in the client bundle).
# Activates the gtag loader sitewide via @next/third-parties and tracks
# client-side route changes too. Unset = no analytics renders.
NEXT_PUBLIC_GA_ID=G-HLL9STZVNF
