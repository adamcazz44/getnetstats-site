# GetNetStats — ad slot configuration
# Copy to .env.local and fill in. All are optional: when unset, the matching
# ad slot renders the dashed "Advertisement" placeholder instead of a real tag.

# --- Google AdSense (300×600 half-page in the hero rail) ---
# Publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad-unit slot id for the half-page unit, e.g. 1234567890
NEXT_PUBLIC_ADSENSE_HALFPAGE_SLOT=

# --- VPN affiliate creative (300×250 rectangle in the hero rail) ---
# Destination/affiliate URL
NEXT_PUBLIC_AFFILIATE_URL=
# Creative image URL (300×250)
NEXT_PUBLIC_AFFILIATE_IMG=
# Accessible alt / aria-label for the creative
NEXT_PUBLIC_AFFILIATE_ALT=Sponsored

# NOTE: Tier 1 (this launch) is fully client-side — no backend env vars needed.
# The serverless API config (e.g. API_ALLOWED_ORIGINS) lives on the tier2-prep
# branch alongside /api/whois, and only applies once Tier 2 ships.
